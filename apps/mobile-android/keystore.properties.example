# Скопируйте в keystore.properties и заполните своими значениями.
# Сам keystore.properties и файл ключа в git не попадают (.gitignore).
#
# Путь указывается относительно каталога mobile-android.
# Держать ключ внутри проекта не обязательно и не рекомендуется:
# storeFile=../../../keys/chinaru-release.jks — тоже рабочий вариант.

storeFile=chinaru-release.jks
storePassword=
keyAlias=chinaru
keyPassword=
