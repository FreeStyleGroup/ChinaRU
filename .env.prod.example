# Production secrets — скопировать в .env.prod на сервере и заполнить.
# НЕ коммитить .env.prod.
#
# Значения ниже — под развёртывание на поддоменах china-ru.ru: основной
# домен занят действующим сайтом, поэтому экземпляр живёт на app/api/admin.
# Меняются на любые другие — домены больше нигде не зашиты.

# ── Домены ──────────────────────────────────────────────────────
# Подставляются в конфигурацию nginx при старте контейнера.
WEB_HOST=app.china-ru.ru
API_HOST=api.china-ru.ru
ADMIN_HOST=admin.china-ru.ru

# Имя каталога сертификата в /etc/letsencrypt/live/.
# Certbot называет каталог по ПЕРВОМУ домену из команды выпуска —
# сверьте по факту, иначе nginx не найдёт файлы и не стартует.
CERT_NAME=app.china-ru.ru

# Публичные URL. Первые два вшиваются в сборку фронта на этапе build,
# менять их после сборки бесполезно — нужно пересобирать образ.
NEXT_PUBLIC_API_URL=https://api.china-ru.ru
NEXT_PUBLIC_SITE_URL=https://app.china-ru.ru
API_PUBLIC_URL=https://api.china-ru.ru
WEB_URL=https://app.china-ru.ru
ADMIN_URL=https://admin.china-ru.ru

# Домен для cookie. Общий родительский, чтобы сессия работала
# и на витрине, и в админке.
COOKIE_DOMAIN=china-ru.ru

# ── Postgres ────────────────────────────────────────────────────
POSTGRES_USER=china_ru_user
POSTGRES_PASSWORD=change_me_strong

# ── JWT ─────────────────────────────────────────────────────────
# Минимум 32 символа каждый. Сгенерировать: openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_min_32_chars_access_secret
JWT_REFRESH_SECRET=change_me_min_32_chars_refresh_secret

# ── Meilisearch / MinIO ─────────────────────────────────────────
MEILI_MASTER_KEY=change_me_master_key
MINIO_ROOT_USER=china_ru_minio
MINIO_ROOT_PASSWORD=change_me_minio_password

# Хранилище файлов: s3 (MinIO). Ключи = MinIO root creds выше;
# endpoint — имя сервиса во внутренней сети compose.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=china_ru_minio
S3_SECRET_KEY=change_me_minio_password
S3_BUCKET=china-ru
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
