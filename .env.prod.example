# Production secrets — скопировать в .env.prod на сервере и заполнить.
# НЕ коммитить .env.prod.
#
# Значения ниже — под развёртывание на поддоменах china-ru.ru: основной
# домен занят действующим сайтом, поэтому экземпляр живёт на po.china-ru.ru.
# Меняются на любые другие — домены больше нигде не зашиты.
#
# 🔥 Почему api и admin ВЛОЖЕНЫ в po.china-ru.ru, а не стоят рядом с ним.
# Витрина и API обязаны делить cookie сессии, значит COOKIE_DOMAIN — их
# общий родитель. У соседей app/api/admin общий родитель только один:
# china-ru.ru. А на нём живёт действующий сайт на Битриксе — и браузер
# отправлял бы ему refresh-токены платформы при каждом обращении, складывая
# их в чужие логи. При вложенности общий родитель — сам po.china-ru.ru,
# и за его пределы cookie не уходят.

# ── Домены ──────────────────────────────────────────────────────
# Подставляются в конфигурацию nginx при старте контейнера.
WEB_HOST=po.china-ru.ru
API_HOST=api.po.china-ru.ru
ADMIN_HOST=admin.po.china-ru.ru

# Имя каталога сертификата в /etc/letsencrypt/live/.
# Certbot называет каталог по ПЕРВОМУ домену из команды выпуска —
# сверьте по факту, иначе nginx не найдёт файлы и не стартует.
CERT_NAME=po.china-ru.ru

# Публичные URL. Первые два вшиваются в сборку фронта на этапе build,
# менять их после сборки бесполезно — нужно пересобирать образ.
NEXT_PUBLIC_API_URL=https://api.po.china-ru.ru
NEXT_PUBLIC_SITE_URL=https://po.china-ru.ru
API_PUBLIC_URL=https://api.po.china-ru.ru
WEB_URL=https://po.china-ru.ru
ADMIN_URL=https://admin.po.china-ru.ru

# Домен для cookie. Общий родитель витрины, API и админки — и ровно он,
# не выше: на china-ru.ru стоит чужой сайт, которому наши cookie не нужны.
COOKIE_DOMAIN=po.china-ru.ru

# ── Postgres ────────────────────────────────────────────────────
POSTGRES_USER=china_ru_user
POSTGRES_PASSWORD=change_me_strong

# ── JWT ─────────────────────────────────────────────────────────
# Минимум 32 символа каждый. Сгенерировать: openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_min_32_chars_access_secret
JWT_REFRESH_SECRET=change_me_min_32_chars_refresh_secret

# ── Хранилище файлов (SeaweedFS, S3) ────────────────────────────
# Одна пара ключей на хранилище и API: compose передаёт её обоим, второго
# экземпляра пароля, который мог бы разойтись с первым, нет.
# Сгенерировать: openssl rand -hex 24
STORAGE_DRIVER=s3
S3_ENDPOINT=http://storage:8333
S3_ACCESS_KEY=china_ru_storage
S3_SECRET_KEY=change_me_storage_secret
S3_BUCKET=china-ru
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ── Почта (подтверждение адреса, восстановление пароля) ─────────
# Без SMTP_HOST письма не отправляются: регистрация работает, но ссылка
# подтверждения и сброс пароля до пользователя не доходят.
# Почта china-ru.ru — на хостинге REG.RU: ящик no-reply@china-ru.ru заводится
# в панели хостинга, SMTP — mail.hosting.reg.ru, порт 465 (SSL).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@china-ru.ru
SMTP_PASSWORD=
MAIL_FROM=China.ru <no-reply@china-ru.ru>

# ── ИИ (необязательно) ──────────────────────────────────────────
# Контент-завод, прогнозы «Гороскопа», перевод названий товаров на EN и 中文.
# Пустой ключ — режим заглушки: шаблонные ответы, перевода нет.
# AITunnel: ключ в личном кабинете aitunnel.ru → «API-ключи».
AI_PROVIDER=aitunnel
AI_API_KEY=
# Модель по умолчанию для aitunnel — gpt-4o-mini; переопределить при необходимости:
AI_MODEL=
