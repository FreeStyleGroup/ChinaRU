# Production secrets — скопировать в .env.prod на сервере и заполнить.
# НЕ коммитить .env.prod.

# Postgres
POSTGRES_USER=china_ru_user
POSTGRES_PASSWORD=change_me_strong

# JWT (минимум 32 символа каждый; сгенерировать: openssl rand -hex 32)
JWT_ACCESS_SECRET=change_me_min_32_chars_access_secret
JWT_REFRESH_SECRET=change_me_min_32_chars_refresh_secret

# Cookies / домены
COOKIE_DOMAIN=china.ru
WEB_URL=https://china.ru
ADMIN_URL=https://admin.china.ru

# Публичные URL для сборки фронта
NEXT_PUBLIC_API_URL=https://api.china.ru
NEXT_PUBLIC_SITE_URL=https://china.ru
# Публичный URL API (для ссылок на файлы/аватары)
API_PUBLIC_URL=https://api.china.ru

# Meilisearch / MinIO
MEILI_MASTER_KEY=change_me_master_key
MINIO_ROOT_USER=china_ru_minio
MINIO_ROOT_PASSWORD=change_me_minio_password

# Хранилище файлов: s3 (MinIO). Ключи = MinIO root creds выше; endpoint — имя сервиса в compose.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=china_ru_minio
S3_SECRET_KEY=change_me_minio_password
S3_BUCKET=china-ru
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
